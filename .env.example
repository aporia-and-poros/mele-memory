# 复制成 .env 再填。.env 不进 git。

# HTTP 的钥匙，可不填：不填的话第一次启动自己生成一把，打在日志里、存在 ./data/memory/token。
# 想自己定也行，至少 16 位：openssl rand -hex 32
MELE_MEMORY_TOKEN=

# 这个人的 UUID（可不填，用默认的）：python3 -c "import uuid; print(uuid.uuid4())"
MELE_MEMORY_USER=

# 逗号隔开：AI 的名字、昵称、用户的名字（称呼停用词用）
MELE_MEMORY_NAMES=

# 用户的名字（星图正中间的爱心；正文提到这个名字的记忆连到它）
MELE_MEMORY_USER_NAME=

# 用户那边的时区（远事按这边的日子算），例：Asia/Shanghai
MELE_MEMORY_TZ=

# 每天备份到 GitHub 私有仓库（可不配）。仓库必须是私有的，公开仓库会被拒绝。
# token 用细粒度的：只选这一个仓库，权限 Contents: Read and write
MELE_MEMORY_BACKUP_REPO=
MELE_MEMORY_BACKUP_TOKEN=
# 每天几点（用上面的时区），默认 4
MELE_MEMORY_BACKUP_HOUR=

# 链接模式（可不配）：给 claude.ai 网页版 / 手机，网址 https://<域名>/mcp/<这串>。
# 这个网址就是钥匙，必须走 HTTPS，别外传。至少 32 位字母数字：openssl rand -hex 32
MELE_MEMORY_LINK_SECRET=

# 数据库密码（数据库不对外开端口，改不改都行）
POSTGRES_PASSWORD=

# 默认只让本机连；给别的机器连改成 0.0.0.0
MELE_MEMORY_BIND=127.0.0.1

# 测试用：不下模型，用假向量起一个轻镜像
# WITH_EMBED=false
# MELE_MEMORY_FAKE_EMBED=1
